# Kantahulay Release Signing Configuration Example
#
# Copy this file to 'keystore.properties' (in repo root or android/ directory)
# and set your Android keystore values below.
#
# Alternatively, set the corresponding environment variables:
#   export KEYSTORE_PATH="/path/to/release.keystore"
#   export KEYSTORE_PASSWORD="your_store_password"
#   export KEY_ALIAS="your_key_alias"
#   export KEY_PASSWORD="your_key_password"
#
# If neither keystore.properties nor environment variables are found,
# the build automatically falls back to Android's debug keystore for easy testing.

storeFile=/path/to/release.keystore
storePassword=your_store_password
keyAlias=your_key_alias
keyPassword=your_key_password
